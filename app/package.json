{
  "private": true,
  "name": "Achievement-Watcher",
  "description": "A sexy achievement file parser with real-time notification.",
  "version": "2.0",
  "main": "./electron/init.js",
  "scripts": {
    "start": "electron .",
    "validate": "node validate-setup.js",
    "test": "node node_modules/jest/bin/jest.js --testPathIgnorePatterns=node_modules",
    "native-rebuild": "call .\\node_modules\\.bin\\electron-rebuild.cmd",
    "clean": "npm prune --production"
  },
  "author": "Manuel Diaz",
  "license": "LGPL-3.0-only",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-context-menu": "^4.0.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@xan105/fs": "^1.2.0",
    "@xan105/ini": "^1.0.1",
    "@xan105/log": "^1.0.2",
    "accountpicture-ms-extractor": "^1.2.4",
    "adm-zip": "^0.5.10",
    "argv-split": "^2.0.1",
    "crc": "^3.8.0",
    "deepmerge": "^4.2.2",
    "fast-glob": "^3.2.4",
    "find-up": "^4.1.0",
    "humanize-duration": "^3.25.1",
    "js-yaml": "^3.14.1",
    "lodash.omit": "^4.5.0",
    "minimist": "^1.2.5",
    "moment": "^2.29.1",
    "node-html-parser": "^4.0.0",
    "normalize-path": "^3.0.0",
    "request-zero": "^0.3.2",
    "steamid": "^1.1.3",
    "xml2js": "^0.4.23"
  },
  "config": {
    "debug": true,
    "user-agent": "Chrome/",
    "disable-gpu": false,
    "window": {
      "width": 1200,
      "height": 800,
      "minWidth": 1200,
      "minHeight": 800,
      "backgroundColor": "#1b2838",
      "frame": false,
      "icon": "resources/icon/icon.png",
      "view": "./view/app.html"
    },
    "update": {
      "github": "xan105/Achievement-Watcher",
      "name": "Achievement.Watcher.Setup.exe"
    },
    "appid": "io.github.xan105.achievement.watcher"
  }
}
